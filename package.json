{
  "name": "mithril-lynx",
  "version": "0.0.0",
  "description": "Mithril.js on Lynx, v2: real mithril/render/render.js driven through a Lynx-backed fake DOM, with an explicit single commit hook (no conditional global flush) and three reload modes (data-light, structural-light, full).",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./background": {
      "types": "./src/background.d.ts",
      "default": "./src/background.js"
    },
    "./main-thread": {
      "types": "./src/main-thread.d.ts",
      "default": "./src/main-thread.js"
    },
    "./plugin": {
      "types": "./plugin.d.ts",
      "default": "./plugin.js"
    },
    "./route": {
      "types": "./src/route.d.ts",
      "default": "./src/route.js"
    },
    "./request": {
      "types": "./src/request.d.ts",
      "default": "./src/request.js"
    }
  },
  "scripts": {
    "test": "rstest run"
  },
  "peerDependencies": {
    "@lynx-js/rspeedy": "^0.17.0",
    "@lynx-js/types": "4.1.0",
    "mithril-runtime": "^1.1.0"
  },
  "dependencies": {
    "@lynx-js/runtime-wrapper-webpack-plugin": "^0.2.4",
    "@lynx-js/template-webpack-plugin": "^0.16.0"
  },
  "devDependencies": {
    "@lynx-js/testing-environment": "npm:@lynx-js/testing-environment-canary@0.3.2-canary-20260803-5a891c73",
    "@rstest/core": "^0.11.3",
    "jsdom": "^28.0.0",
    "mithril-runtime": "^1.1.0",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
